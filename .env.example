# Nexus (Mesa LMS) - personal access token, server-side only
MESA_MCP_URL=https://students.mesaschool.co.in/mcp
MESA_PAT=


# Google Calendar two-way sync (OAuth client from Google Cloud Console). See SETUP.md, "Google Calendar".
# The same OAuth client Supabase uses for sign-in works; it just needs the extra redirect address added.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Project Settings -> API). The publishable key is safe for the browser;
# never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only Google account allowed to sign in (yours). Everyone else is signed straight back out.
ALLOWED_EMAIL=you@example.com

# Gemini API key (Google AI Studio) for class-note processing
GEMINI_API_KEY=
# Optional. Leave empty to auto-pick the best Flash model your key can use.
GEMINI_MODEL=

# OpenRouter key (sk-or-v1-...). If set, class notes use Google Gemini models through OpenRouter.
OPENROUTER_API_KEY=

# 32-byte key (base64) that encrypts stored Wispr tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Notifications ----
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the scheduler: openssl rand -base64 32
CRON_SECRET=
# Supabase secret (service_role) key. Server only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
